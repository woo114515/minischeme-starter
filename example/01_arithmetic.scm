; 例：算术、比较与布尔。每行注释是该表达式的期望输出。
(+ 1 2)          ; → 3
(- 10 4 1)       ; → 5
(* 3 4)          ; → 12
(/ 7 2)          ; → 3   ; 整数相除得整数商
(modulo 17 5)    ; → 2
(quotient 17 5)  ; → 3
(expt 2 10)      ; → 1024
(abs (- 5 9))    ; → 4
(= 1 1)          ; → #t
(< 2 3 4)        ; → #t  ; 链式比较
(> 5 5)          ; → #f
(and #t #f)      ; → #f
(or #f #t)       ; → #t
(not #f)         ; → #t
